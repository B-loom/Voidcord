<?xml version="1.0" encoding="utf-8"?>
<!--
    Android refuse le trafic en clair depuis Android 9. Le serveur de Voidcord n'écoute
    que sur 127.0.0.1, à l'intérieur du bac à sable de l'application : rien ne sort du
    téléphone, et le client a besoin de cette seule exception.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
